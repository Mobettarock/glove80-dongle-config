/* Automatically generated combos definitions */
/ {
    combos {
        compatible = "zmk,combos";

        combo_tildaOnlyCombo {
            timeout-ms = <40>;
            key-positions = <POS_RH_C1R2 POS_RH_C2R2>;
            bindings = <&kp LS(GRAVE)>;
            layers = <LAYER_Main_w_hrm>;
            require-prior-idle-ms = <100>;
        };

        // ctrlAltDel
        combo_ctrlAltDel {
            timeout-ms = <50>;
            key-positions = <POS_LH_C3R1 POS_LH_C2R1>;
            bindings = <&kp LC(LA(DEL))>;
            require-prior-idle-ms = <100>;
        };

        combo_ZoomMenu {
            key-positions = <POS_RH_C2R2 POS_RH_C3R2>;
            bindings = <&excel_zoom_menu>;
            layers = <LAYER_Cursor_right_hand LAYER_Cursor>;
        };
    };
};


        #binding-cells = <0>;
        bindings = <&kp N6>, <&kp HASH>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    n7_lbkt: n7_lbkt {
        compatible = "zmk,behavior-mod-morph";
        #binding-cells = <0>;
        bindings = <&kp N7>, <&kp LBKT>;
        mods = <(MOD_LSFT|MOD_RSFT)>;
    };

    n8_amps: n8_amps {

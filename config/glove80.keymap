                , <&kp RET>;
        };

        // Macro to drop the trace precedent arrow
        excel_zoom_menu: excel_zoom_menu {
            label = "&EXCEL_ZOOM_MENU";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <30>;
            wait-ms = <100>;
            bindings = <&kp LALT>
                , <&kp V>
                , <&kp Z>
                , <&kp TAB>;
        };

        snip_via_app: snip_via_app {
            label = "&SNIP_VIA_APP";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <15>;
            wait-ms = <15>;
            bindings = <&kp LC(LA(F13))>
                , <&macro_wait_time 50>
                , <&kp LA(N)>;
        };

        openCloseParenthesis: openCloseParenthesis {
            label = "&OPENCLOSEPARENTHESIS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <5>;
            wait-ms = <5>;
            bindings = <&kp LS(N9)>
                , <&kp LS(N0)>
                , <&kp LEFT>;
        };

        openCloseBrackets: openCloseBrackets {
            label = "&OPENCLOSEBRACKETS";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            tap-ms = <5>;
            wait-ms = <5>;
            bindings = <&kp LBKT>
                , <&kp RBKT>
                , <&kp LEFT>;
        };
    };
};

/* Automatically generated behavior definitions */

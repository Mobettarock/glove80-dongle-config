    // ==========================================

    hrm_rp_base: hrm_rp_base {
        compatible = "zmk,behavior-hold-tap";
        #binding-cells = <2>;
        flavor = "balanced";
        tapping-term-ms = <250>;
        quick-tap-ms = <175>;
        require-prior-idle-ms = <150>;
        bindings = <&kp>, <&kp>; 
    };

    slash_amps_hrm: slash_amps_hrm {
